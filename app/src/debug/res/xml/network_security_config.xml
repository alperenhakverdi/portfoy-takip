<?xml version="1.0" encoding="utf-8"?>
<!--
  Yalnızca debug derlemesi. Geliştirme bilgisayarındaki antivirüs HTTPS trafiğini kendi sertifikasıyla yeniden imzalayabilir
  (emülatörde "Trust anchor not found"). Debug'da kullanıcı sertifikalarına da güvenilir. Yayın sürümü etkilenmez.
-->
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
